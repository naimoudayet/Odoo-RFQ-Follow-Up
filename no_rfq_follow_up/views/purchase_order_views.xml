    License LGPL-3

    Surfaces the follow-up state on the RFQ form: the "Auto-Chase Vendor"
    toggle (so a buyer can opt a specific RFQ out of chasing) plus, once
    the RFQ has been sent, the sent date and how many reminders have
    fired. The read-only fields stay hidden until the RFQ is actually
    sent so the form is uncluttered for fresh quotations.
-->
<odoo>
    <record id="view_purchase_order_form_rfq_follow_up" model="ir.ui.view">
        <field name="name">purchase.order.form.rfq.follow.up</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="x_rfq_reminder_enabled"
                       invisible="state not in ('draft', 'sent')"/>
                <field name="x_rfq_sent_date"
                       invisible="not x_rfq_sent_date"/>
                <field name="x_rfq_reminder_count"
                       invisible="not x_rfq_sent_date"/>
            </xpath>
        </field>
    </record>
</odoo>
