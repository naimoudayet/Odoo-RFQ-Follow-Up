#. module: no_rfq_follow_up
#: model:mail.template,body_html:no_rfq_follow_up.template_rfq_reminder_3
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">there</t>,\n"
"        <br/><br/>\n"
"        This is a final reminder regarding our Request for Quotation\n"
"        <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">P00001</span>,\n"
"        which remains unanswered.\n"
"        <br/><br/>\n"
"        If we do not hear back from you shortly, we will need to source this\n"
"        purchase elsewhere. We would much rather work with you — please\n"
"        send your quotation, or let us know your situation, today.\n"
"        <br/><br/>\n"
"        Reply to this email or contact\n"
"        <t t-out=\"object.user_id.name or object.company_id.name or ''\"/>.\n"
"        <br/><br/>\n"
"        Best regards,\n"
"        <br/>\n"
"        <t t-out=\"object.user_id.name or object.company_id.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: no_rfq_follow_up
#: model:mail.template,body_html:no_rfq_follow_up.template_rfq_reminder_2
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">there</t>,\n"
"        <br/><br/>\n"
"        We are still awaiting your response to our Request for Quotation\n"
"        <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">P00001</span>.\n"
"        <br/><br/>\n"
"        To keep this purchase on schedule, we would appreciate receiving your\n"
"        quotation as soon as possible. If you are unable to quote, a quick note\n"
"        letting us know would be very helpful.\n"
"        <br/><br/>\n"
"        Please reply to this email or contact\n"
"        <t t-out=\"object.user_id.name or object.company_id.name or ''\"/>.\n"
"        <br/><br/>\n"
"        Best regards,\n"
"        <br/>\n"
"        <t t-out=\"object.user_id.name or object.company_id.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: no_rfq_follow_up
#: model:mail.template,body_html:no_rfq_follow_up.template_rfq_reminder_1
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">there</t>,\n"
"        <br/><br/>\n"
"        We recently sent you our Request for Quotation\n"
"        <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">P00001</span>\n"
"        and wanted to follow up to see whether you have had a chance to review it.\n"
"        <br/><br/>\n"
"        We have not received your quotation yet. Could you share your pricing,\n"
"        lead time and availability when convenient? Simply reply to this email\n"
"        or get in touch with\n"
"        <t t-out=\"object.user_id.name or object.company_id.name or ''\"/>.\n"
"        <br/><br/>\n"
"        Thank you — we look forward to working with you.\n"
"        <br/><br/>\n"
"        Best regards,\n"
"        <br/>\n"
"        <t t-out=\"object.user_id.name or object.company_id.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

