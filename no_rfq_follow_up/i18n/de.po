#. module: no_rfq_follow_up
#: model_terms:ir.ui.view,arch_db:no_rfq_follow_up.res_config_settings_view_form_rfq_follow_up
msgid "RFQ Follow-Up Reminders"
msgstr "Nachfass-Erinnerungen für Angebotsanfragen"

#. module: no_rfq_follow_up
#: model:mail.template,name:no_rfq_follow_up.template_rfq_reminder_3
msgid "RFQ Follow-Up: Final Reminder"
msgstr "Angebotsanfrage Nachfass: Letzte Erinnerung"

#. module: no_rfq_follow_up
#: model:mail.template,name:no_rfq_follow_up.template_rfq_reminder_2
msgid "RFQ Follow-Up: Firm Reminder"
msgstr "Angebotsanfrage Nachfass: Bestimmte Erinnerung"

#. module: no_rfq_follow_up
#: model:mail.template,name:no_rfq_follow_up.template_rfq_reminder_1
msgid "RFQ Follow-Up: Gentle Reminder"
msgstr "Angebotsanfrage Nachfass: Freundliche Erinnerung"

#. module: no_rfq_follow_up
#: model:ir.model.fields,field_description:no_rfq_follow_up.field_purchase_order__x_rfq_reminder_sent
msgid "RFQ Reminders Sent"
msgstr "Gesendete Angebotsanfrage-Erinnerungen"

#. module: no_rfq_follow_up
#: model:ir.model.fields,field_description:no_rfq_follow_up.field_purchase_order__x_rfq_sent_date
msgid "RFQ Sent On"
msgstr "Angebotsanfrage versendet am"

#. module: no_rfq_follow_up
#: model:mail.template,subject:no_rfq_follow_up.template_rfq_reminder_2
msgid "Reminder: quotation still pending for {{ object.name }}"
msgstr "Erinnerung: Angebot noch ausstehend für {{ object.name }}"

#. module: no_rfq_follow_up
#: model:ir.model.fields,field_description:no_rfq_follow_up.field_purchase_order__x_rfq_reminder_count
msgid "Reminders Sent"
msgstr "Versendete Erinnerungen"

#. module: no_rfq_follow_up
#: model:ir.model.fields,field_description:no_rfq_follow_up.field_res_config_settings__rfq_reminder_offset_2
msgid "Second Reminder (days after sent)"
msgstr "Zweite Erinnerung (Tage nach Versand)"

#. module: no_rfq_follow_up
#: model:ir.model.fields,help:no_rfq_follow_up.field_purchase_order__x_rfq_reminder_enabled
msgid ""
"When enabled, the daily scheduled action emails the vendor an escalating "
"follow-up reminder while this RFQ stays unanswered. Untick to stop chasing "
"this particular RFQ."
msgstr ""
"Wenn aktiviert, sendet der tägliche geplante Vorgang dem Lieferanten"
" eskalierende Nachfass-Erinnerungen, solange diese Angebotsanfrage"
" unbeantwortet bleibt. Deaktivieren Sie diese Option, um die Nachverfolgung"
" dieser bestimmten Angebotsanfrage zu beenden."

#. module: no_rfq_follow_up
#: model:ir.model.fields,help:no_rfq_follow_up.field_purchase_order__x_rfq_sent_date
msgid ""
"When this Request for Quotation was first sent to the vendor. Stamped "
"automatically on the draft -> sent transition and used as the anchor for the"
" follow-up reminder schedule."
msgstr ""
"Zeitpunkt, zu dem diese Angebotsanfrage erstmals an den Lieferanten versendet"
" wurde. Wird automatisch beim Übergang von Entwurf zu Versendet gesetzt und"
" dient als Ausgangspunkt für den Zeitplan der Nachfass-Erinnerungen."
