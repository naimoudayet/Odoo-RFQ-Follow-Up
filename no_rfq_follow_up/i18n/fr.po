msgstr "Dernier rappel : réponse requise pour la demande de prix {{ object.name }}"

#. module: no_rfq_follow_up
#: model:mail.template,description:no_rfq_follow_up.template_rfq_reminder_2
msgid "Firmer reminder sent when a vendor still has not answered the RFQ."
msgstr "Rappel plus ferme envoyé lorsqu'un fournisseur n'a toujours pas répondu à la demande de prix."

#. module: no_rfq_follow_up
#: model:ir.model.fields,field_description:no_rfq_follow_up.field_res_config_settings__rfq_reminder_offset_1
msgid "First Reminder (days after sent)"
msgstr "Premier rappel (jours après envoi)"

#. module: no_rfq_follow_up
#: model:mail.template,subject:no_rfq_follow_up.template_rfq_reminder_1
msgid "Following up: Request for Quotation {{ object.name }}"
msgstr "Relance : demande de prix {{ object.name }}"

#. module: no_rfq_follow_up
#: model:mail.template,description:no_rfq_follow_up.template_rfq_reminder_1
msgid ""
"Friendly first follow-up sent when a vendor has not yet answered a sent RFQ."
msgstr ""
"Premier rappel courtois envoyé lorsqu'un fournisseur n'a pas encore répondu "
"à une demande de prix envoyée."

