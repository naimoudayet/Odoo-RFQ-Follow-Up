msgstr "Recordatorio final (días tras el envío)"

#. module: no_rfq_follow_up
#: model:mail.template,description:no_rfq_follow_up.template_rfq_reminder_3
msgid ""
"Final reminder sent when a vendor has gone silent; the buyer is copied in."
msgstr ""
"Recordatorio final enviado cuando un proveedor no ha respondido; se envía "
"copia al comprador."

#. module: no_rfq_follow_up
#: model:mail.template,subject:no_rfq_follow_up.template_rfq_reminder_3
msgid "Final reminder: response needed on RFQ {{ object.name }}"
msgstr "Recordatorio final: se requiere respuesta a la solicitud de presupuesto {{ object.name }}"

#. module: no_rfq_follow_up
#: model:mail.template,description:no_rfq_follow_up.template_rfq_reminder_2
msgid "Firmer reminder sent when a vendor still has not answered the RFQ."
msgstr "Recordatorio firme enviado cuando el proveedor todavía no ha respondido la solicitud de presupuesto."

#. module: no_rfq_follow_up
#: model:ir.model.fields,field_description:no_rfq_follow_up.field_res_config_settings__x_rfq_reminder_offset_1
msgid "First Reminder (days after sent)"
msgstr "Primer recordatorio (días tras el envío)"

#. module: no_rfq_follow_up
#: model:mail.template,subject:no_rfq_follow_up.template_rfq_reminder_1
msgid "Following up: Request for Quotation {{ object.name }}"
msgstr "Seguimiento: solicitud de presupuesto {{ object.name }}"

#. module: no_rfq_follow_up
#: model:mail.template,description:no_rfq_follow_up.template_rfq_reminder_1
msgid ""
"Friendly first follow-up sent when a vendor has not yet answered a sent RFQ."
msgstr ""
"Primer seguimiento amistoso enviado cuando un proveedor aún no ha respondido "
"a una solicitud de presupuesto enviada."

#. module: no_rfq_follow_up
#: model:ir.model.fields,field_description:no_rfq_follow_up.field_purchase_order__id
